# 腾讯云代理后端环境变量样例
#
# 安全约束：
# - 本文件只允许出现变量名和占位值，不得写入真实密钥
# - 真实密钥通过本地 .env（不入库）或部署平台环境变量注入
# - 后端启动时只检查变量是否存在，不打印变量值
#
# 依据：TR_TRAE_GATE_T2_BACKEND_PROXY_TASK.md 第 "Security" 节

# 腾讯云密钥（仅占位，不填真实值）
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=

# 本地加密存储的加密密钥（可选；不设置时自动生成 server/.tencent-credential-key）
# 用于加密 server/.tencent-credentials.enc 中的凭据
TENCENT_CREDENTIALS_KEY=

# 腾讯云地域（默认广州，真实接入时可调整）
TENCENT_CLOUD_REGION=ap-guangzhou

# DeepSeek（发票类别识别 + 缺失字段补齐，仅占位，不填真实值）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 后端代理端口（默认 8787，可通过环境变量覆盖）
BACKEND_PROXY_PORT=8787
