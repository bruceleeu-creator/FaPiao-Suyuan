{
  "name": "invoice-evidence-chain-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "backend:dev": "node server/tencentProxyServer.mjs",
    "backend:smoke": "node scripts/backend-smoke.mjs",
    "credential:store": "node scripts/store-tencent-credential.mjs",
    "credential:status": "node -e \"import('./server/tencentCredentialStore.mjs').then(m => console.log(JSON.stringify(m.getTencentCredentialStatus(), null, 2)))\"",
    "validate": "npm test && npm run build && npm run backend:smoke"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}